[user]
	name = Delong Fu
	# email is set per machine by install.py (git config --global user.email)
[core]
	editor = vim
	autocrlf = input
	ignorecase = true
	precomposeunicode = true
	excludesfile = ~/.gitignore_global
[alias]
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)%Creset' --abbrev-commit
	ls = !git ls-files -m | xargs
	cm = commit -m
	po = push origin
	amend = commit --amend --no-edit
	sync = !git fetch origin $1:$1
	forget = update-index --skip-worktree 
	unforget = update-index --no-skip-worktree 
	cp = cherry-pick
	root = rev-parse --show-toplevel
	ss= !git commit --message "WIP" && git stash -u && git reset --soft HEAD^
	rename = !export old_branch=":$(git rev-parse --abbrev-ref HEAD)" && git branch -m $1 && git push -f origin $old_branch
	pr = "!f() { if ! command -v gh >/dev/null; then echo 'git pr: gh is not installed (brew install gh)' >&2; return 1; fi; gh pr create --web; }; f"
	dc = diff --cached
[color]
	status = auto
	ui = true
[color "status"]
	changed = red
	untracked = normal
	added = magenta
[color "diff"]
	old = red
	new = magenta
[push]
	default = current
	autoSetupRemote = true
[rerere]
	enabled = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[protocol]
	version = 2
[feature]
	manyFiles = true
[pull]
	rebase = false
[credential]
	helper = osxkeychain
